{
  "name": "art-gallery",
  "version": "1.0.0",
  "description": "Art Gallery — Express API + static frontend, deployed on Vercel",
  "main": "backend/server.js",
  "scripts": {
    "start": "npm run build && node backend/server.js",
    "dev": "npm run dev:frontend",
    "dev:frontend": "vite --config vite.config.js --host 0.0.0.0",
    "dev:api": "npm run dev:backend",
    "dev:backend": "node backend/server.js",
    "build": "vite build --config vite.config.js",
    "preview": "vite preview --config vite.config.js --host 0.0.0.0",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.x"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hellopalmy-web/Art-Gallery-API.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hellopalmy-web/Art-Gallery-API/issues"
  },
  "homepage": "https://github.com/hellopalmy-web/Art-Gallery-API#readme",
  "devDependencies": {
    "vite": "^6.4.5"
  }
}
